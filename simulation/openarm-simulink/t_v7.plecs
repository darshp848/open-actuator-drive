    Component {
      Type          CScript
      Name          "FOC"
      Show          on
      Position      [6600, 1200]
      Direction     up
      Flipped       off
      LabelPosition east
      Parameter {
        Variable      "DialogGeometry"
        Value         ""
        Show          off
