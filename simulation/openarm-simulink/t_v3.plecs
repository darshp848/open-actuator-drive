    Component {
      Type          CScript
      Name          "FOC"
      Show          on
      Position      [9243, 2477]
      Direction     up
      Flipped       off
      LabelPosition east
      Parameter {
        Variable      "DialogGeometry"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
        Value         "5"
        Show          off
      }
      Parameter {
        Variable      "NumOutputs"
        Value         "8"
        Show          off
      }
      Parameter {
        Variable      "NumContStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumDiscStates"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "NumZCSignals"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "DirectFeedthrough"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Ts"
        Value         "1/fsw"
        Show          off
      }
      Parameter {
        Variable      "TerminalBasedSampleTimes"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         "pp, Rs, Ls, lam, kp_i, ki_i, v_frac, 1/fsw, ref_t, ref_wm, ref_iq, ref"
"_vb"
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "HighlightLevel"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "#include <math.h>\n#define P(i) ParamRealData(i, 0)\n#define PP P(0)\n"
"#define RS P(1)\n#define LS P(2)\n#define LAM P(3)\n#define KP P(4)\n#"
"define KI P(5)\n#define VFRAC P(6)\n#define TS P(7)\n#define NREF Para"
"mNumElements(8)\n#define REFT(k) ParamRealData(8, k)\n#define REFW(k) "
"ParamRealData(9, k)\n#define REFI(k) ParamRealData(10, k)\n#define REF"
"V(k) ParamRealData(11, k)\nstatic double zd, zq, dn[3], out_wm, out_vb"
", out_iqr, out_id, out_iq;\nstatic int kref;\nstatic void lookup(doubl"
"e t, double *w, double *iqr, double *vb)\n{\n    while (kref < NREF - "
"2 && REFT(kref + 1) <= t) kref++;\n    double t0 = REFT(kref), t1 = RE"
"FT(kref + 1);\n    double f = (t1 > t0) ? (t - t0)/(t1 - t0) : 0.0;\n "
"   if (f < 0) f = 0;\n    if (f > 1) f = 1;\n    *w = REFW(kref) + f*("
"REFW(kref + 1) - REFW(kref));\n    *iqr = REFI(kref) + f*(REFI(kref + "
"1) - REFI(kref));\n    *vb = REFV(kref) + f*(REFV(kref + 1) - REFV(kre"
"f));\n}\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "zd = 0; zq = 0; kref = 0; dn[0] = dn[1] = dn[2] = 0.5; out_id = 0; out"
"_iq = 0;\nlookup(0.0, &out_wm, &out_iqr, &out_vb);\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "OutputSignal(0, 0) = dn[0]; OutputSignal(0, 1) = dn[1]; OutputSignal(0"
", 2) = dn[2];\nOutputSignal(0, 3) = out_wm; OutputSignal(0, 4) = out_v"
"b; OutputSignal(0, 5) = out_iqr;\nOutputSignal(0, 6) = out_id; OutputS"
"ignal(0, 7) = out_iq;\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "double ia = InputSignal(0, 0), ib = InputSignal(0, 1), ic = InputSigna"
"l(0, 2);\ndouble thm = InputSignal(0, 3), vb = InputSignal(0, 4);\ndou"
"ble t = CurrentTime;\nlookup(t + TS, &out_wm, &out_iqr, &out_vb);\ndou"
"ble th = PP*thm, we = PP*out_wm, a = 2.0*M_PI/3.0;\ndouble id = 2.0/3."
"0*(ia*cos(th) + ib*cos(th - a) + ic*cos(th + a));\ndouble iq = -2.0/3."
"0*(ia*sin(th) + ib*sin(th - a) + ic*sin(th + a));\ndouble ed = -id, eq"
" = out_iqr - iq;\ndouble vd = KP*ed + zd - we*LS*iq;\ndouble vq = KP*e"
"q + zq + we*LAM + we*LS*id;\ndouble vmax = VFRAC*(vb > 1 ? vb : 1);\nd"
"ouble vm = sqrt(vd*vd + vq*vq);\ndouble s = (vm > vmax) ? vmax/vm : 1."
"0;\nvd *= s; vq *= s;\nif (s >= 0.999) { zd += KI*ed*TS; zq += KI*eq*T"
"S; }\ndouble tha = th + 1.5*we*TS;\ndouble v[3], vmx, vmn;\nv[0] = vd*"
"cos(tha) - vq*sin(tha);\nv[1] = vd*cos(tha - a) - vq*sin(tha - a);\nv["
"2] = vd*cos(tha + a) - vq*sin(tha + a);\nvmx = fmax(v[0], fmax(v[1], v"
"[2])); vmn = fmin(v[0], fmin(v[1], v[2]));\nfor (int k = 0; k < 3; k++"
") {\n    double d = 0.5 + (v[k] - 0.5*(vmx + vmn))/(vb > 1 ? vb : 1);\"
"n    dn[k] = d < 0 ? 0 : (d > 1 ? 1 : d);\n}\nout_id = id; out_iq = iq"
";\n"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
