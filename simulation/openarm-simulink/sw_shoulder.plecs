        Value         "1/fsw"
        Show          off
      }
      Parameter {
        Variable      "TerminalBasedSampleTimes"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         "pp, Rs, Ls, lam, kp_i, ki_i, v_frac, 1/fsw, ref_t, ref_wm, r"
"ef_iq, ref_vb"
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "HighlightLevel"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "#include <math.h>\n#define P(i) ParamRealData(i, 0)\n#define P"
"P P(0)\n#define RS P(1)\n#define LS P(2)\n#define LAM P(3)\n#def"
"ine KP P(4)\n#define KI P(5)\n#define VFRAC P(6)\n#define TS P("
"7)\n#define NREF (ParamDim(8, 0)*ParamDim(8, 1))\n#define PI_ "
"3.14159265358979323846\n#define REFT(k) ParamRealData(8, k)\n#"
"define REFW(k) ParamRealData(9, k)\n#define REFI(k) ParamReal"
"Data(10, k)\n#define REFV(k) ParamRealData(11, k)\nstatic doub"
"le zd, zq, dn[3], out_wm, out_vb, out_iqr, out_id, out_iq;\ns"
"tatic int kref;\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "zd = 0; zq = 0; kref = 0; dn[0] = dn[1] = dn[2] = 0.5; out_i"
"d = 0; out_iq = 0;\n{\n    double tl = 0.0;\n    while (kref < "
"NREF - 2 && REFT(kref + 1) <= tl) kref++;\n    double t0 = RE"
"FT(kref), t1 = REFT(kref + 1);\n    double f = (t1 > t0) ? (t"
"l - t0)/(t1 - t0) : 0.0;\n    if (f < 0) f = 0;\n    if (f > 1"
") f = 1;\n    out_wm = REFW(kref) + f*(REFW(kref + 1) - REFW("
"kref));\n    out_iqr = REFI(kref) + f*(REFI(kref + 1) - REFI("
"kref));\n    out_vb = REFV(kref) + f*(REFV(kref + 1) - REFV(k"
"ref));\n}\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "OutputSignal(0, 0) = dn[0]; OutputSignal(0, 1) = dn[1]; Outp"
"utSignal(0, 2) = dn[2];\nOutputSignal(0, 3) = out_wm; OutputS"
"ignal(0, 4) = out_vb; OutputSignal(0, 5) = out_iqr;\nOutputSi"
"gnal(0, 6) = out_id; OutputSignal(0, 7) = out_iq;\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "double ia = InputSignal(0, 0), ib = InputSignal(0, 1), ic = "
"InputSignal(0, 2);\ndouble thm = InputSignal(0, 3), vb = Inpu"
"tSignal(0, 4);\ndouble t = CurrentTime;\n{\n    double tl = t +"
" TS;\n    while (kref < NREF - 2 && REFT(kref + 1) <= tl) kre"
"f++;\n    double t0 = REFT(kref), t1 = REFT(kref + 1);\n    do"
"uble f = (t1 > t0) ? (tl - t0)/(t1 - t0) : 0.0;\n    if (f < "
"0) f = 0;\n    if (f > 1) f = 1;\n    out_wm = REFW(kref) + f*"
"(REFW(kref + 1) - REFW(kref));\n    out_iqr = REFI(kref) + f*"
"(REFI(kref + 1) - REFI(kref));\n    out_vb = REFV(kref) + f*("
"REFV(kref + 1) - REFV(kref));\n}\ndouble th = PP*thm, we = PP*"
"out_wm, a = 2.0*PI_/3.0;\ndouble id = 2.0/3.0*(ia*cos(th) + i"
"b*cos(th - a) + ic*cos(th + a));\ndouble iq = -2.0/3.0*(ia*si"
"n(th) + ib*sin(th - a) + ic*sin(th + a));\ndouble ed = -id, e"
"q = out_iqr - iq;\ndouble vd = KP*ed + zd - we*LS*iq;\ndouble "
"vq = KP*eq + zq + we*LAM + we*LS*id;\ndouble vmax = VFRAC*(vb"
" > 1 ? vb : 1);\ndouble vm = sqrt(vd*vd + vq*vq);\ndouble s = "
"(vm > vmax) ? vmax/vm : 1.0;\nvd *= s; vq *= s;\nif (s >= 0.99"
"9) { zd += KI*ed*TS; zq += KI*eq*TS; }\ndouble tha = th + 1.5"
"*we*TS;\ndouble v[3], vmx, vmn;\nv[0] = vd*cos(tha) - vq*sin(t"
"ha);\nv[1] = vd*cos(tha - a) - vq*sin(tha - a);\nv[2] = vd*cos"
"(tha + a) - vq*sin(tha + a);\nvmx = fmax(v[0], fmax(v[1], v[2"
"])); vmn = fmin(v[0], fmin(v[1], v[2]));\nfor (int k = 0; k <"
" 3; k++) {\n    double d = 0.5 + (v[k] - 0.5*(vmx + vmn))/(vb"
" > 1 ? vb : 1);\n    dn[k] = d < 0 ? 0 : (d > 1 ? 1 : d);\n}\no"
"ut_id = id; out_iq = iq;\n"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
