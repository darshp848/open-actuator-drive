    Component {
      Type          CScript
      Name          "FOC"
      Show          on
      Position      [3600, 1800]
      Direction     up
      Flipped       off
      LabelPosition east
      Parameter {
        Variable      "DialogGeometry"
        Value         ""
        Show          off
